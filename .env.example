# --- Arga Labs (twins: stripe, hubspot, slack, gmail) ---
ARGA_LABS_API_KEY=
ARGA_API_BASE=https://api.argalabs.com

# Safety interlock. Each provision consumes a scarce monthly validation run,
# so provisioning is OFF unless you deliberately enable it.
ARGA_ALLOW_PROVISION=false
TWIN_MODE=sim

# --- Twin base URLs (filled in when provisioning real twins) ---
STRIPE_API_BASE=
HUBSPOT_API_BASE=
SLACK_API_BASE=
GMAIL_API_BASE=

# --- Service tokens ---
STRIPE_API_KEY=sk_test_arga_twin
HUBSPOT_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL=#approvals

# --- Lemma tracing ---
LEMMA_API_KEY=
LEMMA_PROJECT_ID=

# --- Gmail (draft-only, never send) ---
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=gmail_token.json

# --- Judge: Antigravity CLI. No API key, no per-token billing. ---
AGY_BIN=agy
AGY_MODEL=claude-sonnet-4-6
JUDGE_CONCURRENCY=6
JUDGE_TIMEOUT=180
